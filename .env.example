# Solana RPC endpoint (optional — defaults to public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# LLM API key for AI-powered explanations (optional — falls back to rule-based)
# Compatible with OpenAI, or any OpenAI-compatible provider.
# To use a different provider, edit the callLLM() function in app/api/explain/route.ts
LLM_API_KEY=sk-...
